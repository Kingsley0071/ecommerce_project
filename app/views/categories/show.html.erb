<%= render 'shared/breadcrumbs', breadcrumbs: @breadcrumbs %>

<div class="container mt-4">
  <h1 class="mb-4"><%= @category.name %> Products</h1>
  <div class="row">
    <% @products.each do |product| %>
      <div class="col-md-4 mb-4 d-flex align-items-stretch">
        <div class="card shadow-sm h-100">
          <% if product.image.attached? %>
            <%= image_tag product.image, class: "card-img-top", style: "height: 200px; object-fit: contain; background: #f8f9fa;" %>
          <% else %>
            <img src="https://via.placeholder.com/300x200?text=No+Image" class="card-img-top" style: "height: 200px; object-fit: contain; background: #f8f9fa;">
          <% end %>
          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= product.name %></h5>
            <p class="card-text"><%= truncate(product.description, length: 100) %></p>
            <p class="card-text"><strong>Price:</strong> $<%= product.price %></p>
            <%= link_to "View Details", product_path(product), class: "btn btn-primary mt-auto" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
  <%= link_to "Back to Categories", categories_path, class: "btn btn-outline-secondary mt-3" %>
</div>