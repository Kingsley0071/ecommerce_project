<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ecommerce Project" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
  
    <!-- Add Bootstrap CDN link above your stylesheet_link_tag -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <!-- Header -->
    <header>
      <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
          <%= link_to "Ecommerce Project", root_path, class: "navbar-brand fw-bold" %>
          
          <!-- Mobile toggle button -->
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
          </button>
          
          <!-- Navigation links -->
          <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
              <li class="nav-item">
                <%= link_to "Home", root_path, class: "nav-link #{'active fw-bold' if current_page?(root_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Products", products_path, class: "nav-link #{'active fw-bold' if current_page?(products_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Categories", categories_path, class: "nav-link #{'active fw-bold' if current_page?(categories_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "About", about_path, class: "nav-link #{'active fw-bold' if current_page?(about_path)}" %>
              </li>
              <li class="nav-item">
                <%= link_to "Contact", contact_path, class: "nav-link #{'active fw-bold' if current_page?(contact_path)}" %>
              </li>
            </ul>
            
            <!-- Right side navigation -->
            <div class="d-flex align-items-center">
              <%= link_to cart_path, class: "btn btn-outline-light me-3 position-relative" do %>
                <i class="fas fa-shopping-cart"></i> Cart
                <% if current_cart.any? %>
                  <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                    <%= current_cart.values.sum %>
                  </span>
                <% end %>
              <% end %>
              
              <% if user_signed_in? %>
                <div class="dropdown">
                  <button class="btn btn-outline-light dropdown-toggle" type="button" id="userDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-user"></i> <%= current_user.username || current_user.email %>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                    <li><%= link_to "Profile", edit_user_registration_path, class: "dropdown-item" %></li>
                    <li><%= link_to "My Orders", orders_path, class: "dropdown-item" %></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item text-danger" %></li>
                  </ul>
                </div>
              <% else %>
                <%= link_to "Sign Up", new_user_registration_path, class: "btn btn-outline-light me-2" %>
                <%= link_to "Login", new_user_session_path, class: "btn btn-light" %>
              <% end %>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <!-- Flash messages -->
    <% flash.each do |key, message| %>
  <div class="alert alert-<%= key == "notice" ? "success" : "danger" %> alert-dismissible fade show" role="alert">
    <%= message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% end %>

    <!-- Main content -->
    <main class="flex-grow-1">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-light py-4 mt-5">
      <div class="container">
        <div class="row">
          <div class="col-md-4">
            <h5>Ecommerce Project</h5>
            <p class="text-muted">Your one-stop shop for everything you need.</p>
          </div>
          <div class="col-md-2">
            <h6>Shop</h6>
            <ul class="list-unstyled">
              <li><%= link_to "Products", products_path, class: "text-muted text-decoration-none" %></li>
              <li><%= link_to "Categories", categories_path, class: "text-muted text-decoration-none" %></li>
            </ul>
          </div>
          <div class="col-md-2">
            <h6>Account</h6>
            <ul class="list-unstyled">
              <% if user_signed_in? %>
                <li><%= link_to "Profile", edit_user_registration_path, class: "text-muted text-decoration-none" %></li>
                <li><%= link_to "My Orders", orders_path, class: "text-muted text-decoration-none" %></li>
              <% else %>
                <li><%= link_to "Sign Up", new_user_registration_path, class: "text-muted text-decoration-none" %></li>
                <li><%= link_to "Login", new_user_session_path, class: "text-muted text-decoration-none" %></li>
              <% end %>
            </ul>
          </div>
          <div class="col-md-2">
            <h6>Support</h6>
            <ul class="list-unstyled">
              <li><%= link_to "About", about_path, class: "text-muted text-decoration-none" %></li>
              <li><%= link_to "Contact", contact_path, class: "text-muted text-decoration-none" %></li>
            </ul>
          </div>
          <div class="col-md-2">
            <h6>Follow Us</h6>
            <div class="d-flex gap-2">
              <a href="#" class="text-muted"><i class="fab fa-facebook"></i></a>
              <a href="#" class="text-muted"><i class="fab fa-twitter"></i></a>
              <a href="#" class="text-muted"><i class="fab fa-instagram"></i></a>
            </div>
          </div>
        </div>
        <hr class="my-4">
        <div class="row align-items-center">
          <div class="col-md-6">
            <p class="mb-0 text-muted">&copy; <%= Time.current.year %> Ecommerce Project. All rights reserved.</p>
          </div>
          <div class="col-md-6 text-md-end">
            <small class="text-muted">Built with Ruby on Rails</small>
          </div>
        </div>
      </div>
    </footer>

    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Font Awesome for icons (optional) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  </body>
</html>