<%= render 'shared/breadcrumbs', breadcrumbs: @breadcrumbs %>

<div class="container mt-5">
  <h2>Your Orders</h2>
  <% if @orders.any? %>
    <div class="table-responsive">
      <table class="table">
        <thead>
          <tr>
            <th>Order #</th>
            <th>Date</th>
            <th>Status</th>
            <th>Total</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr>
              <td><%= order.id %></td>
              <td><%= order.created_at.strftime("%Y-%m-%d") %></td>
              <td><%= order.status %></td>
              <td>$<%= order.total %></td>
              <td><%= link_to "View", order_path(order), class: "btn btn-sm btn-outline-primary" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info">You have no past orders.</div>
  <% end %>
</div>