<%= render 'shared/breadcrumbs', breadcrumbs: @breadcrumbs %>

<div class="container mt-5">
  <h2>Order #<%= @order.id %></h2>
  <p><strong>Date:</strong> <%= @order.created_at.strftime("%Y-%m-%d") %></p>
  <p><strong>Status:</strong> <%= @order.status %></p>
  <p><strong>Total:</strong> $<%= @order.total %></p>
  <p><strong>Shipping Address:</strong> <%= @order.address %>, <%= @order.city %>, <%= @order.province %>, <%= @order.postal_code %></p>

  <% if current_user.admin? %>
    <div class="mb-3">
      <%= form_with model: @order, url: order_path(@order), method: :patch, local: true do |f| %>
        <%= f.label :status, "Update Status", class: "form-label" %>
        <%= f.select :status, ["pending", "paid", "shipped"], {}, class: "form-select d-inline-block w-auto ms-2" %>
        <%= f.submit "Update Status", class: "btn btn-sm btn-primary ms-2" %>
      <% end %>
    </div>
  <% end %>

  <h4 class="mt-4">Order Items</h4>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>Product</th>
          <th>Quantity</th>
          <th>Unit Price</th>
          <th>Tax Rate</th>
          <th>Subtotal (incl. tax)</th>
        </tr>
      </thead>
      <tbody>
        <% @order.order_items.each do |item| %>
          <tr>
            <td><%= item.product.name %></td>
            <td><%= item.quantity %></td>
            <td>$<%= number_with_precision(item.price, precision: 2) %></td>
            <td><%= number_to_percentage(item.tax_rate * 100, precision: 2) %></td>
            <td>$<%= number_with_precision(item.price * item.quantity * (1 + item.tax_rate), precision: 2) %></td>
        </tr>
     <% end %>
      </tbody>
    </table>
  </div>

  <%= link_to "Back to Orders", orders_path, class: "btn btn-outline-secondary mt-3" %>
</div>