<div class="col-md-4 mb-4">
  <div class="card h-100 shadow-sm">
    <% if product.image.attached? %>
      <%= image_tag product.image.variant(resize_to_limit: [400, 250]), class: "card-img-top", alt: product.name %>
    <% else %>
      <%= image_tag "placeholder.png", class: "card-img-top", alt: "No image" %>
    <% end %>
    <div class="card-body d-flex flex-column">
      <h5 class="card-title"><%= product.name %></h5>
      <p class="card-text"><%= truncate(product.description, length: 80) %></p>
      <p class="fw-bold mb-2">Price: $<%= number_with_precision(product.price, precision: 2) %></p>
      <div class="mt-auto">
        <%= link_to "View Details", product_path(product), class: "btn btn-primary w-100 mb-2" %>
        <%= button_to "Add to Cart", cart_items_path(product_id: product.id), method: :post, class: "btn btn-success w-100 mb-2" %>
        <% if user_signed_in? %>
          <% user_comment = product.comments.find_by(user: current_user) %>
          <% if user_comment %>
            <%= link_to "Edit Comment", edit_product_comment_path(product, user_comment), class: "btn btn-secondary w-100 mb-2" %>
            <%= link_to "Delete Comment", product_comment_path(product, user_comment), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-outline-danger w-100 mb-2" %>
          <% else %>
            <%= link_to "Add Comment", new_product_comment_path(product), class: "btn btn-outline-secondary w-100 mb-2" %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>