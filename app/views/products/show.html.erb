<%= render 'shared/breadcrumbs', breadcrumbs: @breadcrumbs %>

<div class="container mt-4">
  <div class="card p-4 shadow-sm">
    <div class="row">
      <div class="col-md-5 text-center">
        <% if @product.image.attached? %>
          <%= image_tag @product.image.variant(resize_to_limit: [300, 300]), class: "img-fluid rounded", style: "max-height: 350px; object-fit: contain; background: #f8f9fa;" %>
        <% else %>
          <img src="https://via.placeholder.com/350x350?text=No+Image" class="img-fluid rounded" style="max-height: 350px; object-fit: contain; background: #f8f9fa;">
        <% end %>
      </div>
      <div class="col-md-7">
        <h1 class="fw-bold mb-3"><%= @product.name %></h1>
        <p class="lead text-muted mb-4"><%= @product.description %></p>
        <p class="h4 mb-4"><span class="fw-bold text-success">Price:</span> $<%= number_with_precision(@product.price, precision: 2) %></p>
        <%= link_to "Back to Products", products_path, class: "btn btn-outline-primary" %>