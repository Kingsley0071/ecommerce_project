<%= render 'shared/breadcrumbs', breadcrumbs: @breadcrumbs %>

<div class="container mt-4">
  <div class="card p-4 shadow-sm">
    <div class="row">
      <div class="col-md-5 text-center">
        <% if @product.image.attached? %>
          <%= image_tag @product.image.variant(resize_to_limit: [300, 300]), class: "img-fluid rounded", style: "max-height: 350px; object-fit: contain; background: #f8f9fa;" %>
        <% else %>
          <img src="https://via.placeholder.com/350x350?text=No+Image" class="img-fluid rounded" style="max-height: 350px; object-fit: contain; background: #f8f9fa;">
        <% end %>
      </div>
      <div class="col-md-7">
        <h1 class="fw-bold mb-3"><%= @product.name %></h1>
        <p class="lead text-muted mb-4"><%= @product.description %></p>
        <p class="h4 mb-4"><span class="fw-bold text-success">Price:</span> $<%= number_with_precision(@product.price, precision: 2) %></p>
        <%= link_to "Back to Products", products_path, class: "btn btn-outline-primary" %>
      </div>
    </div>
  </div>

  <!-- Comments Section -->
  <div class="card mt-4 shadow-sm">
    <div class="card-body">
      <h4 class="mb-3"><i class="bi bi-chat-dots"></i> Comments</h4>
      <% if @product.comments.any? %>
        <% @product.comments.each do |comment| %>
          <div class="border rounded p-2 mb-2">
            <strong><%= comment.user.username || comment.user.email %>:</strong>
            <%= comment.content %>
            <% if user_signed_in? && (comment.user == current_user || (current_user.respond_to?(:admin?) && current_user.admin?)) %>
              <%= link_to "Edit", edit_product_comment_path(@product, comment), class: "btn btn-sm btn-outline-primary ms-2" %>
              <%= link_to "Delete", product_comment_path(@product, comment), method: :delete, data: { confirm: "Are you sure?" }, class: "btn btn-sm btn-outline-danger ms-1" %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <p class="text-muted">No comments yet. Be the first to comment!</p>
      <% end %>

      <% if user_signed_in? %>
        <%= form_with(model: [@product, @product.comments.build], local: true) do |f| %>
          <div class="mb-3">
            <%= f.text_area :content, class: "form-control", placeholder: "Add a comment..." %>
          </div>
          <%= f.submit "Post Comment", class: "btn btn-primary" %>
        <% end %>
      <% else %>
        <p class="mt-3 text-muted">You must be logged in to comment.</p>
      <% end %>
    </div>
  </div>
</div>