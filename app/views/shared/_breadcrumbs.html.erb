<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <% breadcrumbs.each_with_index do |crumb, i| %>
      <li class="breadcrumb-item <%= 'active' if i == breadcrumbs.size - 1 %>">
        <% if i < breadcrumbs.size - 1 %>
          <%= link_to crumb[:name], crumb[:path] %>
        <% else %>
          <%= crumb[:name] %>
        <% end %>
      </li>
    <% end %>
  </ol>
</nav>